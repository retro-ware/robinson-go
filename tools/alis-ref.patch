+// Harness: ALIS_SAVEDIR keeps written files out of the data directory
+// (like the Go port's FileSys.SaveDir); reads look there first.
+static const char *save_redirect(const char *path, int write, char *out)
+{
+    const char *dir = getenv("ALIS_SAVEDIR");
+    if (!dir)
+        return path;
+    const char *base = strrchr(path, '/');
+    base = base ? base + 1 : path;
+    snprintf(out, 1024, "%s/%s", dir, base);
+    for (char *c = out + strlen(dir) + 1; *c; c++)
+        *c = toupper((unsigned char)*c);
+    FILE *t = fopen(out, "rb");
+    if (t) { fclose(t); return out; }
+    if (!write)
+        return path;
+    FILE *src = fopen(path, "rb");
+    if (src)
+    {
+        FILE *dst = fopen(out, "wb");
+        int ch;
+        while (dst && (ch = fgetc(src)) != EOF) fputc(ch, dst);
