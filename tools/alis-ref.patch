diff --git a/src/him31.h b/src/him31.h
new file mode 100644
index 0000000..cbf2f62
--- /dev/null
+++ b/src/him31.h
@@ -0,0 +1,30 @@
+// START.EXE (ALIS 3.1, Robinson's Requiem PC) him* handlers: another entity's
+// variables. The byte and word forms check the entity index (error screen
+// 0x1b..0x21) and skip dead entities (vram <= 0); 0x9ebf..0xac9b.
+#pragma once
+#include "alis.h"
+#include "alis_private.h"
+#include "mem.h"
+#include <stdio.h>
+#include <string.h>
+
+#define HIM31 (alis.platform.version == 31)
+
+static inline s32 him31_ent(s16 off, int err)
+{
+    s32 ent = (s16)xread16(alis.script->vram_org + off);
+    if (err && ent < 0)
+    {
+        fprintf(stderr, "%s: Error %d: him negatif\n", alis.script->name, err);
+        alis.state = eAlisStateStopped;
+        alis.script->running = 0;
+    }
+    return (s32)xread32(alis.atent + ent);
+}
+
+static inline u32 him31_tab(void)
+{
+    s16 off = (s16)script_read16();
+    s16 var = (s16)script_read16();
+    return (u32)(him31_ent(var, 0) + off);
+}
